# Do not copy this file mechanically. Run scripts/devstack.py init in each worktree.
# Linux/macOS use ':'; Windows uses ';'. The helper selects the right separator.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.worktree-data.yaml:compose.tls-internal.yaml
COMPOSE_PROJECT_NAME=example-feature-a1b2c3d4
COMPOSE_PROFILES=worktree-data
STACK_ID=example-feature-a1b2c3d4
INGRESS_NETWORK=agent-ingress
SHARED_DATA_NETWORK=agent-data
DEV_UID=1000
DEV_GID=1000
WEB_HOST=web-example-feature-a1b2c3d4.localhost
API_HOST=api-example-feature-a1b2c3d4.localhost
DB_HOST=dev-postgres
POSTGRES_DB=example_feature_a1b2c3d4
POSTGRES_USER=dev
POSTGRES_PASSWORD=replace-with-a-random-worktree-local-value
REDIS_HOST=dev-redis
REDIS_PREFIX=example-feature-a1b2c3d4:
